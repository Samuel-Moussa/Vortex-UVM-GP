# ============================================================================
#  Vortex UVM — .gitignore
#  Only source, scripts, docs, and per-config coverage banks are tracked.
#  Everything generated by a build or a simulation run is ignored below.
# ============================================================================

# ---- Simulation & build artifacts ------------------------------------------
work/
build/
obj_dir/
transcript
vsim.dbg
*.wlf
*.vcd
*.fsdb
*.log
*.old

# Compiled objects / libraries / binaries
*.o
*.a
*.so
*.d
*.dll
*.exe
*.elf

# SimX golden-model build outputs
Vortex/sim/simx/obj/
Vortex/sim/simx/simx
Vortex/sim/simx/simx_config.stamp
Vortex/tests/riscv/riscv-vector-tests/go/

# ---- QuestaSim / ModelSim ---------------------------------------------------
modelsim.ini
*.mpf
*.mti
*.qtl
*.qdb
*.qpg
*.cr.mti

# ---- Coverage ---------------------------------------------------------------
# On main: coverage banks are regenerated report output, too large to track
# here (1.5G, 1700+ files) — kept on vortex_merge/industrial_transformations
# instead. Regenerate locally with `make cov-merge` from Vortex/sim/uvmsim/.
*.ucdb
cov_work/
vortex_uvm_env/cov/

# ---- Run outputs ------------------------------------------------------------
vortex_uvm_env/results/
vortex_uvm_env/flists/trace/
trace/
ramulator*.log
ramulator*.stats*
*.vstf
__pycache__/
*.pyc

# ---- Vendored / third-party (built or synced separately) --------------------
core-v-verif/

# ---- Backups ----------------------------------------------------------------
*_backup*/
backup/
*.bak
*.backup
*~
*.swp
*.swo

# ---- OS / IDE ---------------------------------------------------------------
.DS_Store
Thumbs.db
*:Zone.Identifier
.vscode/
.idea/
*.code-workspace

# ---- Local working context (not part of the deliverable) --------------------
CLAUDE.md
.claude/
env/
samuel_all_branches.txt
*.pptx
Vortex UVM - Graduation Presentation*.pdf
graphify-out/
